include README.md LICENSE CITATION.cff CONTRIBUTING.md THIRD_PARTY_NOTICES.md AGENTS.md
include Makefile uv.lock
include .gitignore setup.cfg
recursive-include docs *.md
recursive-include paper *.py *.md *.csv *.json *.svg *.png *.pdf *.otf *.ttf *.txt
recursive-include scripts *.py
recursive-include provenance *.json SHA256SUMS
recursive-include tests *.py
recursive-include .github *.yml
global-exclude *.pyc *.pyo
prune outputs
prune experiments
prune prepared
